# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments
.venv/
venv/
env/

# PyTorch / Triton / Inductor caches and JIT build dirs
.torchinductor_cache/
torchinductor_*/
.triton/
torch_extensions/
*.ptx
*.cubin

# Profiler outputs (large binaries — never commit)
*.nsys-rep
*.sqlite
*.ncu-rep
*.qdrep
profiles/
traces/

# Local scratch
scratch/
tmp/
*.log

# Upstream kernels cloned by scripts/fetch_third_party.sh for the head-to-head.
# Never vendored: each has its own licence and release cadence.
third_party/

# Committed results are curated JSON only; block stray large artifacts
results/**/*.pt
results/**/*.bin
results/**/*.csv.gz
*.ckpt
*.pth

# Editors / OS
.vscode/
.idea/
.DS_Store

# Locally-extracted Python headers (see scripts/fetch_python_headers.sh)
.local-toolchain/
.cache/

# Cannot be pushed by the available token (no `workflow` scope); see issue #1
.github/
